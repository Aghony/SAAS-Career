generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id               String        @id @default(uuid(7))
  name             String
  email            String        @unique
  passwordHash     String
  refreshTokenHash String?
  applications     Application[]
  resumes          Resume[]
  projects         Project[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum ApplicationStatus {
  wishlist
  applied
  assessment
  interview
  technical_test
  offer
  rejected
  withdrawn
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
  freelance
}
model Application {
  id             String            @id @default(uuid(7))
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  position       String
  jobUrl         String?
  location       String?
  employmentType EmploymentType?
  salaryMin      Int?
  salaryMax      Int?
  appliedAt      DateTime?
  deadline       DateTime?
  status         ApplicationStatus @default(wishlist)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  
  @@index([userId, status])
}

model Resume {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

model Project {
  id              String    @id @default(uuid(7))
  userId          String 
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String 
  description     String?   @db.Text
  role            String? 
  techStack       String[]
  projectUrl      String?
  repoUrl         String?
  thumbnailUrl    String?
  startDate       DateTime?
  endDate         DateTime?
  isOngoing       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

 @@index([userId])
}